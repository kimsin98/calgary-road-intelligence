{
  "name": "calgary-road-disruption-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:data": "node pipelines/prepare.mjs && node pipelines/enrich-volumes.mjs && node pipelines/audit-spatial.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run compress:data && tsc && vite build",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "node tests/run-browser.mjs",
    "fetch:data": "node pipelines/fetch.mjs",
    "fetch:weather": "node pipelines/fetch-weather.mjs",
    "prepare:weather": "node pipelines/prepare-weather.mjs",
    "audit:spatial": "node pipelines/audit-spatial.mjs",
    "compress:data": "node pipelines/compress-data.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "maplibre-gl": "^5.0.0",
    "papaparse": "^5.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
